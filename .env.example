# --- Application (publiques, embarquées dans le bundle) ---
VITE_SUPABASE_URL=https://doxnpachkxjxxmirybwy.supabase.co
# Tableau de bord Supabase > Project Settings > API Keys > clé « publishable » (ou anon)
VITE_SUPABASE_ANON_KEY=
# Générée par `npm run vapid` ; la clé privée va dans les secrets des fonctions
VITE_VAPID_PUBLIC_KEY=

# --- Scripts locaux uniquement (jamais dans l'application) ---
# Bouton « Connect » > Session pooler (port 5432), avec le mot de passe de la base
SUPABASE_DB_URL=
# Project Settings > API Keys > clé secrète « service_role »
SUPABASE_SERVICE_ROLE_KEY=
# supabase.com/dashboard/account/tokens : jeton personnel, pour déployer les fonctions
SUPABASE_ACCESS_TOKEN=
# Générées par `npm run vapid` (la publique va aussi dans VITE_VAPID_PUBLIC_KEY)
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@previenergie.ci

# --- Secrets des fonctions Edge (envoyés par `npm run deploy -- secrets`) ---
# Adresse publique de l'application (liens des alertes, retour de paiement)
APP_URL=
# Origines autorisées à appeler les fonctions (séparées par des virgules)
APP_ORIGINS=http://localhost:5173
# Généré automatiquement s'il est vide
CRON_SECRET=
# Lecture des photos
ANTHROPIC_API_KEY=
# Modèle Claude (défaut claude-opus-5-5 ; claude-haiku-5-5 coûte environ 40 fois moins cher)
CLAUDE_MODEL=
# Email des alertes : resend ou brevo
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=
# SMTP pour le code de connexion (même prestataire en général)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# WhatsApp Business (API Cloud de Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=previenergie_alerte
# SMS : orange ou twilio
SMS_PROVIDER=
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_SENDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Paiement mobile money
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
