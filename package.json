{
  "name": "previenergie",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.sw.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sql": "node scripts/test-sql.mjs",
    "icons": "pwa-assets-generator",
    "check": "npm run typecheck && npm test && npm run test:sql",
    "vapid": "node scripts/vapid.mjs",
    "deploy": "node --env-file=.env.local --use-env-proxy scripts/deploy.mjs",
    "comptes:test": "node --env-file=.env.local --use-env-proxy scripts/comptes-test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "pg": "^8.23.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-precaching": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
